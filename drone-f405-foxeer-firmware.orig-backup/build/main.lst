 116:Core/Src/main.c **** static void task_1khz_ctrl(void)
 117:Core/Src/main.c **** {
 118:Core/Src/main.c ****     imu_read(&g_imu);
 119:Core/Src/main.c **** 
 120:Core/Src/main.c ****     /* CW270 alignment + bias correction */
 121:Core/Src/main.c ****     g_omega_meas[0] = -(g_imu.gyro_dps[GYRO_ROLL_IDX]  - g_gyro_bias[GYRO_ROLL_IDX])
 122:Core/Src/main.c ****                       * 0.01745329f;
 123:Core/Src/main.c ****     g_omega_meas[1] =  (g_imu.gyro_dps[GYRO_PITCH_IDX] - g_gyro_bias[GYRO_PITCH_IDX])
 124:Core/Src/main.c ****                       * 0.01745329f;
 125:Core/Src/main.c ****     g_omega_meas[2] =  (g_imu.gyro_dps[GYRO_YAW_IDX]   - g_gyro_bias[GYRO_YAW_IDX])
 126:Core/Src/main.c ****                       * 0.01745329f;
 127:Core/Src/main.c **** 
 128:Core/Src/main.c ****     /* UKF predict every tick, update every other tick */
 129:Core/Src/main.c ****     float gyro_rps[3] = { g_omega_meas[0], g_omega_meas[1], g_omega_meas[2] };
 130:Core/Src/main.c ****     float accel_g[3]  = { g_imu.accel_g[0], g_imu.accel_g[1], g_imu.accel_g[2] };
 131:Core/Src/main.c ****     ukf_predict(&g_ukf, gyro_rps, DT_CTRL);
 132:Core/Src/main.c ****     if (g_tick_count & 1u)
 133:Core/Src/main.c ****         ukf_update(&g_ukf, accel_g, gyro_rps, CHI2_95_6DOF);
 134:Core/Src/main.c **** 
 135:Core/Src/main.c ****     /* Fault: update comm status */
 136:Core/Src/main.c ****     fault_state_t fst = fault_update(&g_fault, (uint32_t)HAL_GetTick());
 137:Core/Src/main.c **** 
 138:Core/Src/main.c ****     /* RC input */
 139:Core/Src/main.c ****     uint16_t thro_us = CRSF_GetChannelUs(CRSF_CH_THROTTLE);
 140:Core/Src/main.c ****     uint16_t roll_us = CRSF_GetChannelUs(CRSF_CH_ROLL);
 141:Core/Src/main.c ****     uint16_t pitch_us= CRSF_GetChannelUs(CRSF_CH_PITCH);
 142:Core/Src/main.c ****     uint16_t yaw_us  = CRSF_GetChannelUs(CRSF_CH_YAW);
 143:Core/Src/main.c ****     uint16_t aux_us  = CRSF_GetChannelUs(CRSF_CH_AUX1);
 144:Core/Src/main.c **** 
ARM GAS  /tmp/ccdyN6FM.s 			page 4


 145:Core/Src/main.c ****     bool link_up = CRSF_IsLinkUp((uint32_t)HAL_GetTick());
 146:Core/Src/main.c ****     if (!link_up) fault_report_comm_rx(&g_fault, 0);
 147:Core/Src/main.c ****     else          fault_report_comm_rx(&g_fault, (uint32_t)HAL_GetTick());
 148:Core/Src/main.c **** 
 149:Core/Src/main.c ****     /* Arming FSM */
 150:Core/Src/main.c ****     if (!link_up || fst >= FAULT_COMM_LOST) {
 151:Core/Src/main.c ****         g_arm = STATE_DISARMED;
 152:Core/Src/main.c ****     } else if (g_arm == STATE_DISARMED
 153:Core/Src/main.c ****                && aux_us > ARM_AUX_US
 154:Core/Src/main.c ****                && thro_us < ARM_THRO_MAX_US) {
 155:Core/Src/main.c ****         g_arm = STATE_ARMED;
 156:Core/Src/main.c ****         motor_arm();
 157:Core/Src/main.c ****         indi_reset(&g_indi, MOTOR_IDLE);
 158:Core/Src/main.c ****     } else if (g_arm == STATE_ARMED && aux_us <= ARM_AUX_US) {
 159:Core/Src/main.c ****         g_arm = STATE_DISARMED;
 160:Core/Src/main.c ****     }
 161:Core/Src/main.c **** 
 162:Core/Src/main.c ****     led_set(1, g_arm == STATE_ARMED);
 163:Core/Src/main.c **** 
 164:Core/Src/main.c ****     if (g_arm == STATE_DISARMED || fst >= FAULT_EMERGENCY_LAND) {
 165:Core/Src/main.c ****         motor_disarm();
 166:Core/Src/main.c ****         return;
 167:Core/Src/main.c ****     }
 168:Core/Src/main.c **** 
 169:Core/Src/main.c ****     /* Rate setpoints from sticks (rad/s) */
 170:Core/Src/main.c ****     float omega_ref[3];
 171:Core/Src/main.c ****     omega_ref[0] = ((float)roll_us  - 1500.0f) / 500.0f * MAX_ROLL_RATE_RPS;
 172:Core/Src/main.c ****     omega_ref[1] = ((float)pitch_us - 1500.0f) / 500.0f * MAX_PITCH_RATE_RPS;
 173:Core/Src/main.c ****     omega_ref[2] = ((float)yaw_us   - 1500.0f) / 500.0f * MAX_YAW_RATE_RPS;
 174:Core/Src/main.c **** 
 175:Core/Src/main.c ****     /* MRAC adaptive control signal */
 176:Core/Src/main.c ****     float u_mrac[3];
 177:Core/Src/main.c ****     mrac_update(&g_mrac, g_omega_meas, omega_ref, u_mrac);
 178:Core/Src/main.c **** 
 179:Core/Src/main.c ****     /* ADRC disturbance estimate */
 180:Core/Src/main.c ****     float f_hat[3];
 181:Core/Src/main.c ****     adrc_get_disturbance(&g_adrc, f_hat);
 182:Core/Src/main.c ****     {
 183:Core/Src/main.c ****         float omega_ukf[3];
 184:Core/Src/main.c ****         ukf_get_rates(&g_ukf, omega_ukf);
 185:Core/Src/main.c ****         float u_adrc[3];
 186:Core/Src/main.c ****         float r_dot[3] = {0};
 187:Core/Src/main.c ****         float u_prev_adrc[3] = { g_omega_meas[0], g_omega_meas[1], g_omega_meas[2] };
 188:Core/Src/main.c ****         adrc_update(&g_adrc, g_omega_meas, omega_ref, r_dot, u_prev_adrc, u_adrc);
 189:Core/Src/main.c ****     }
 190:Core/Src/main.c ****     adrc_get_disturbance(&g_adrc, f_hat);
 191:Core/Src/main.c **** 
 192:Core/Src/main.c ****     /* Angular acceleration reference for INDI */
 193:Core/Src/main.c ****     float alpha_ref[3];
 194:Core/Src/main.c ****     alpha_ref[0] = KP_RATE     * (omega_ref[0] - g_omega_meas[0]) - f_hat[0] + u_mrac[0];
 195:Core/Src/main.c ****     alpha_ref[1] = KP_RATE     * (omega_ref[1] - g_omega_meas[1]) - f_hat[1] + u_mrac[1];
 196:Core/Src/main.c ****     alpha_ref[2] = KP_RATE_YAW * (omega_ref[2] - g_omega_meas[2]) - f_hat[2] + u_mrac[2];
 197:Core/Src/main.c **** 
 198:Core/Src/main.c ****     /* Throttle */
 199:Core/Src/main.c ****     float throttle = ((float)thro_us - 1000.0f) / 1000.0f;
 200:Core/Src/main.c ****     if (throttle < 0.0f) throttle = 0.0f;
 201:Core/Src/main.c ****     if (throttle > 1.0f) throttle = 1.0f;
ARM GAS  /tmp/ccdyN6FM.s 			page 5


 202:Core/Src/main.c ****     throttle = MOTOR_IDLE + throttle * (1.0f - MOTOR_IDLE);
 203:Core/Src/main.c **** 
 204:Core/Src/main.c ****     /* INDI: compute motor commands */
 205:Core/Src/main.c ****     float u_motor[4];
 206:Core/Src/main.c ****     if (fst == FAULT_MOTOR_FAULT) {
 207:Core/Src/main.c ****         /* CAM fault-tolerant allocation */
 208:Core/Src/main.c ****         float tau[4];
 209:Core/Src/main.c ****         float I[3] = { IXX, IYY, IZZ };
 210:Core/Src/main.c ****         tau[0] = throttle * K_THRUST * 4.0f;
 211:Core/Src/main.c ****         tau[1] = alpha_ref[0] * I[0];
 212:Core/Src/main.c ****         tau[2] = alpha_ref[1] * I[1];
 213:Core/Src/main.c ****         tau[3] = alpha_ref[2] * I[2];
 214:Core/Src/main.c ****         cam_solve(&g_cam, tau, u_motor);
 215:Core/Src/main.c ****     } else {
 216:Core/Src/main.c ****         indi_update(&g_indi, g_omega_meas, alpha_ref, throttle, u_motor);
 217:Core/Src/main.c ****     }
 218:Core/Src/main.c **** 
 219:Core/Src/main.c ****     motor_set_all(u_motor);
 220:Core/Src/main.c **** }

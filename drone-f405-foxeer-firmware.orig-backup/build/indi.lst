   3:Control/indi.c **** #include <math.h>
   4:Control/indi.c **** #include <string.h>
   5:Control/indi.c **** 
   6:Control/indi.c **** /* Betaflight/KISS motor order, X-config:
   7:Control/indi.c ****  * M1=rear-right(CCW), M2=front-right(CW),
   8:Control/indi.c ****  * M3=rear-left(CW),   M4=front-left(CCW)
   9:Control/indi.c ****  *
  10:Control/indi.c ****  * G rows = [roll, pitch, yaw], cols = [M1..M4]
  11:Control/indi.c ****  * roll:  [-1, -1, +1, +1] × g_r
  12:Control/indi.c ****  * pitch: [+1, -1, +1, -1] × g_p
  13:Control/indi.c ****  * yaw:   [-1, +1, +1, -1] × g_y */

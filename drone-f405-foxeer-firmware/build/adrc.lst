   1:Control/adrc.c **** #include "adrc.h"
   2:Control/adrc.c **** #include <string.h>
   3:Control/adrc.c **** 
   4:Control/adrc.c **** /* 3rd-order ESO for 2nd-order plant:
   5:Control/adrc.c ****  *   θ_dot  = ω          (z1 ≈ θ)
   6:Control/adrc.c ****  *   ω_dot  = f + b0*u   (z2 ≈ ω, z3 ≈ f = total disturbance)
   7:Control/adrc.c ****  *
   8:Control/adrc.c ****  * ESO (Euler discrete):
   9:Control/adrc.c ****  *   e      = y - z1
  10:Control/adrc.c ****  *   z1    += dt * (z2 + β1*e)
  11:Control/adrc.c ****  *   z2    += dt * (z3 + β2*e + b0*u)
  12:Control/adrc.c ****  *   z3    += dt * (β3*e)
  13:Control/adrc.c ****  *
  14:Control/adrc.c ****  * Pole placement at -ω_o (all three):
  15:Control/adrc.c ****  *   β1 = 3*ω_o,  β2 = 3*ω_o²,  β3 = ω_o³
  16:Control/adrc.c ****  *
  17:Control/adrc.c ****  * Control law:
  18:Control/adrc.c ****  *   u0  = kp*(r - z1) + kd*(r_dot - z2)
  19:Control/adrc.c ****  *   u   = (u0 - z3) / b0                */
  20:Control/adrc.c **** 

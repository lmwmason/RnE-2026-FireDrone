  26:Estimation/ukf.c **** static void process_sigma(float *sp, float dt)
  27:Estimation/ukf.c **** {
  28:Estimation/ukf.c ****     float omega[3] = { sp[IDX_WX], sp[IDX_WY], sp[IDX_WZ] };
  29:Estimation/ukf.c ****     quat_t q, q_new;
  30:Estimation/ukf.c ****     sigma_to_quat(sp, &q);
  31:Estimation/ukf.c ****     quat_integrate(&q, omega, dt, &q_new);

+/* ESC + motor + prop lag.  INDI adds its increment to what the rotors are doing now, not to what
+ * was commanded one tick ago, otherwise the loop sees a lag-free actuator and limit-cycles. */
+#define INDI_ACT_TAU_S  0.025f
+
 /* Betaflight/KISS motor order, X-config:
  * M1=rear-right(CCW), M2=front-right(CW),
  * M3=rear-left(CW),   M4=front-left(CCW)
@@ -42,13 +46,14 @@
 
